{
  "name": "platform3",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/engine",
    "packages/client",
    "tools/sim"
  ],
  "scripts": {
    "dev": "npm run dev -w @p3/client",
    "build": "npm run build -w @p3/client",
    "preview": "npm run preview -w @p3/client",
    "test": "vitest run",
    "typecheck": "tsc -p packages/shared && tsc -p packages/engine && tsc -p packages/client && tsc -p tools/sim",
    "sim": "npm run sim -w @p3/sim --",
    "verify": "tsx packages/engine/src/verifyLog.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
